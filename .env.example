# Copy this file to .env and fill in the values. Never commit .env.
# Everything here works with placeholders: the game runs on made-up
# demo data until you add real keys.

# --- Database (Render gives you this when you create a PostgreSQL database)
DATABASE_URL=postgres://farpost:farpost@localhost:5432/farpost

# --- Website address (used in sign-in emails)
APP_URL=http://localhost:3000

# --- Secret used to sign things. Make up a long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Football data
# "mock" = made-up demo league (no subscription needed)
# "api-football" = real data from api-football.com (needs API_FOOTBALL_KEY)
FOOTBALL_PROVIDER=mock
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# League and season to follow (39 is API-Football's id for England's top division)
API_FOOTBALL_LEAGUE_ID=39
API_FOOTBALL_SEASON=2026
# Which plan you bought: free | pro | ultra | mega (sets safe request pacing)
API_FOOTBALL_PLAN=free
# Fetch several matches in one call (normal). Set to false for the per-match fallback.
API_FOOTBALL_BATCH=true

# --- Email (sign-in links). Leave blank to print links in the server log instead.
RESEND_API_KEY=
EMAIL_FROM="Far Post <login@example.com>"

# --- Admin: the email address(es) that get the Admin pages, comma separated
ADMIN_EMAILS=you@example.com

# --- Where alerts go (defaults to the admin emails)
ALERT_EMAIL=
